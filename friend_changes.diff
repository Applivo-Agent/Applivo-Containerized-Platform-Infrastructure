+}
+
+/* ─── CARD 3: Multi-Channel Cursors ────────────────────────── */
+function CursorsGraphic() {
+  return (
+    <div className="w-full flex justify-center items-center h-[180px] relative">
+      <div className="absolute z-10 rounded-[18px] w-[60px] h-[60px] bg-[#0ea5e9] border border-[#38bdf8] flex items-center justify-center shadow-[0_15px_30px_rgba(0,0,0,0.6),inset_0_2px_10px_rgba(255,255,255,0.3)]">
+        <Target className="w-8 h-8 text-white" strokeWidth={1.5} />
+      </div>
+
+      {/* Tiny generic mac cursors layered closely */}
