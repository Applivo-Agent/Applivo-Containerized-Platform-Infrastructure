+/* ─── CARD 1: Sync Graphic (Nodes) ─────────────────────────── */
+function SyncGraphGraphic() {
+  const nodes = [
+    { id: 0, x: 200, y: 150, main: true, bg: "#0ea5e9", border: "#38bdf8", shadow: "rgba(14,165,233,0.5)", icon: <Brain className="w-7 h-7 text-white" strokeWidth={1.5} /> },
+    { id: 1, x: 100, y: 70, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <Briefcase className="w-5 h-5 text-[#38bdf8]" strokeWidth={1.5} /> },
+    { id: 2, x: 280, y: 60, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <Globe className="w-5 h-5 text-[#f59e0b]" strokeWidth={1.5} /> },
+    { id: 3, x: 60, y: 190, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <Mail className="w-5 h-5 text-[#10b981]" strokeWidth={1.5} /> },
+    { id: 4, x: 330, y: 180, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <FileText className="w-5 h-5 text-[#a855f7]" strokeWidth={1.5} /> },
+    { id: 5, x: 150, y: 270, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <Layers className="w-5 h-5 text-[#ec4899]" strokeWidth={1.5} /> },
+    { id: 6, x: 270, y: 250, bg: "#0a0a0a", border: "#222", shadow: "rgba(0,0,0,0.8)", icon: <Monitor className="w-5 h-5 text-[#ef4444]" strokeWidth={1.5} /> },
+  ];
+
+  return (
+    <div className="absolute inset-0 flex items-center justify-center overflow-hidden">
+      {/* Extremely Faint Background Code */}
+      <div className="absolute inset-0 flex items-center justify-center opacity-[0.02] pointer-events-none p-6 z-0">
+        <pre className="text-[11px] text-white font-mono leading-[2] tracking-wider w-full h-full whitespace-pre-wrap flex items-center justify-center text-center">
+          {`{
+  "agent_id": "agt_92xkL",
+  "name": "Onboarding Assistant",
+  "environment": "production",
+  "triggers": [
+    { "type": "event", "source": "signup_form" }
+  ],
+  "workflow": {
+    "steps": [
+      { "step_id": "s1", "type": "message", "channel": "slack" }
+    ]
+  }
+}`}
+        </pre>
+      </div>
+
+      <div className="relative w-[400px] h-[340px] z-10">
+        {/* Connection Lines connecting centers */}
+        <svg className="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 400 340">
+          {nodes.slice(1).map((n) => (
+            <motion.line
+              key={n.id}
+              x1={nodes[0].x} y1={nodes[0].y} x2={n.x} y2={n.y}
+              stroke="#262626" strokeWidth={1} strokeLinecap="round"
+              initial={{ pathLength: 0, opacity: 0 }}
+              animate={{ pathLength: 1, opacity: 1 }}
+              transition={{ duration: 1.5, delay: 0.2 + n.id * 0.1, ease: 'easeOut' }}
+            />
+          ))}
+        </svg>
+
+        {/* Link Icons positioned exactly mid-way on the lines */}
+        {nodes.slice(1, 4).map((n) => (
+          <motion.div
+            key={`icon-${n.id}`}
+            className="absolute z-10 bg-[#080808]"
+            style={{
+              left: (nodes[0].x + n.x) / 2 - 12,
+              top: (nodes[0].y + n.y) / 2 - 12,
+              borderRadius: '20px',
+            }}
+            initial={{ opacity: 0, scale: 0.5 }}
+            animate={{ opacity: 1, scale: 1 }}
+            transition={{ delay: 1.2, duration: 0.4 }}
+          >
+            <div className="bg-[#111111] border border-[#2a2a2a] rounded-full p-[5px] m-[2px]">
+               <Link2 className="w-[10px] h-[10px] text-[#777]" />
+            </div>
+          </motion.div>
+        ))}
+
+        {/* Nodes replacing Avatars */}
+        {nodes.map((n, i) => (
+          <motion.div
+            key={i}
+            className="absolute rounded-full flex items-center justify-center z-20"
+            style={{
+              left: n.x - (n.main ? 28 : 20),
+              top: n.y - (n.main ? 28 : 20),
+              width: n.main ? 56 : 40,
+              height: n.main ? 56 : 40,
