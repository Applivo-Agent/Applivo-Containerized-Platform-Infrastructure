# ── Applivo SaaS Configuration ────────────────────────────
# Copy this file to .env and fill in your values
# Generate secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── Application Settings ──────────────────────────────────
APP_NAME=Applivo
APP_ENV=production                     # APP_ENV=production
APP_HOST=0.0.0.0
                       # Listen address
APP_PORT=8000                          # Listen port
DEBUG=false                            # Enable debug mode
SECRET_KEY=<generate with: openssl rand -hex 32>
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ── CORS ──────────────────────────────────────────────────
# Add your production domain(s) here
ALLOWED_ORIGINS=["https://yourdomain.com"]

# ── Database (PostgreSQL for SaaS) ────────────────────────
DATABASE_URL=postgresql+asyncpg://applivo:<generate-password>@database:5432/applivo
DATABASE_URL_SYNC=postgresql://applivo:<generate-password>@database:5432/applivo

# PostgreSQL container password
POSTGRES_PASSWORD=<generate-password>

# ── Redis ─────────────────────────────────────────────────
# Redis password (REQUIRED for production - generate with: openssl rand -hex 16)
REDIS_PASSWORD=<generate-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── AI / LLM ─────────────────────────────────────────────
# Groq API (recommended - fast and free tier available)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gemini API (fallback provider)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Provider configuration
AI_PROVIDER=groq                # Primary: groq | gemini
FALLBACK_PROVIDER=gemini        # Fallback when primary fails

# Model configuration
OPENAI_MODEL_HEAVY=llama3-70b-8192    # For complex tasks
OPENAI_MODEL_LIGHT=llama3-8b-8192     # For simple tasks

# ── Razorpay Payment Gateway ─────────────────────────────
# Get keys at: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_verification

# ── Telegram Notifications ─────────────────────────────────
# Create bot via @BotFather and get token
TELEGRAM_BOT_TOKEN=
# Get your chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=

# ── Email Notifications ────────────────────────────────────
# Gmail: Use App Password (not regular password)
# Go to: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Applivo

# ── IMAP (Email Monitoring) ──────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here

# ── Internshala Credentials ────────────────────────────────
INTERNShALA_EMAIL=your_email@example.com
INTERNShALA_PASSWORD=your_password_here

# ── Auto Apply Settings ────────────────────────────────────
AUTO_APPLY_ENABLED=false               # Enable auto-apply
AUTO_APPLY_MATCH_THRESHOLD=75          # Minimum match score (0-100)
AUTO_APPLY_DAILY_LIMIT=10              # Max applications per day (overrides plan limit)
AUTO_APPLY_REQUIRE_APPROVAL=true       # Require manual approval
USE_COVER_LETTER=false                 # Generate cover letters during applications

# ── User Profile ───────────────────────────────────────────
USER_NAME=Your Name
USER_EMAIL=your_email@example.com
USER_PHONE=+91XXXXXXXXXX
USER_LOCATION=Your City
USER_LINKEDIN_URL=https://linkedin.com/in/yourprofile
USER_GITHUB_URL=https://github.com/yourusername
USER_DESIRED_ROLES=["Machine Learning", "Data Science", "AI"]
USER_DESIRED_LOCATIONS=["Remote", "Bangalore", "Chennai"]
USER_EXPERIENCE_LEVEL=entry            # entry | mid | senior
USER_OPEN_TO_REMOTE=true
USER_MIN_SALARY=0

# ── Storage ────────────────────────────────────────────────
LOCAL_STORAGE_PATH=./storage

# ── Security ───────────────────────────────────────────────
JWT_SECRET_KEY=<generate with: openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=                        # AES-256-GCM encryption key (auto-generated if empty)

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_REQUESTS=100                # Max requests per window
RATE_LIMIT_WINDOW_SECONDS=60           # Window size in seconds

# ── Scrape Settings ───────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6                # Hours between scrape cycles
MAX_JOBS_PER_CYCLE=200                 # Max jobs to scrape per cycle
